{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "画面の言葉（novel.story.json）",
  "description": "シナリオの外で画面に出す言葉と話し手の呼び名。発言・地の文・字幕はシナリオ assets/talk/curse_chat.yarn。",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Doc の形の版。いまは 2"
    },
    "note": {
      "type": "string",
      "description": "人間と AI のためのメモ（ゲームは読まない）"
    },
    "title": {
      "type": "string",
      "description": "タイトル画面の題"
    },
    "warning": {
      "type": "string",
      "description": "タイトル画面の音の注意（ヘッドホン推奨など）"
    },
    "hint": {
      "type": "string",
      "description": "タイトル画面の下の操作の案内"
    },
    "titleAmbience": {
      "type": "string",
      "description": "タイトル画面の環境音（amb_<名前>。空なら鳴らさない）"
    },
    "names": {
      "type": "object",
      "description": "話し手の id（src/Talk.flix の Speaker）→ 呼び名",
      "additionalProperties": {
        "type": "string"
      }
    },
    "labels": {
      "type": "object",
      "description": "言葉の鍵（src/StoryDoc.flix の Label）→ 言葉。無い鍵は既定の言葉で出る",
      "properties": {
        "newGame": {
          "type": "string"
        },
        "continue": {
          "type": "string"
        },
        "loadGame": {
          "type": "string"
        },
